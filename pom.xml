<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.lareferencia</groupId>
        <artifactId>lareferencia-parent</artifactId>
        <version>5.0.0-rc5</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>org.lareferencia</groupId>
    <artifactId>lareferencia-repository-dashboard</artifactId>
    <packaging>pom</packaging>
    <properties>
        <dashboard.node.dir>${project.build.directory}/frontend</dashboard.node.dir>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <node.version>v22.14.0</node.version>
        <npm.version>10.9.2</npm.version>
        <dashboard.frontend>web</dashboard.frontend>
        <dashboard.dist>web/dist</dashboard.dist>
        <dashboard.static.dir>${project.basedir}/../lareferencia-lrharvester-app/dashboard-static</dashboard.static.dir>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>
                <configuration>
                    <installDirectory>${dashboard.node.dir}</installDirectory>
                    <workingDirectory>${project.basedir}/${dashboard.frontend}</workingDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals><goal>install-node-and-npm</goal></goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <npmVersion>${npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>sync-npm-version</id>
                        <phase>generate-resources</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration>
                            <arguments>version ${project.version} --no-git-tag-version --allow-same-version --ignore-scripts</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <goals><goal>npm</goal></goals>
                        <configuration><arguments>ci --no-audit --no-fund</arguments></configuration>
                    </execution>
                    <execution>
                        <id>build-dashboard</id>
                        <phase>prepare-package</phase>
                        <goals><goal>npm</goal></goals>
                        <configuration><arguments>run build</arguments></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>publish-dashboard-static</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${dashboard.static.dir}"/>
                                <delete includeemptydirs="true" failonerror="true">
                                    <fileset dir="${dashboard.static.dir}"/>
                                </delete>
                                <copy todir="${dashboard.static.dir}" overwrite="true">
                                    <fileset dir="${project.basedir}/${dashboard.dist}"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>dashboard-react</id>
            <properties>
                <dashboard.static.dir>${project.build.directory}/react-static</dashboard.static.dir>
            </properties>
            <build><plugins><plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions><execution>
                    <id>package-react-dashboard</id>
                    <phase>package</phase>
                    <goals><goal>run</goal></goals>
                    <configuration>
                        <target xmlns:mvn="http://maven.apache.org/ANTRUN">
                            <zip destfile="${project.build.directory}/${project.build.finalName}-react.zip"
                                 basedir="${dashboard.static.dir}"/>
                            <mvn:attachartifact file="${project.build.directory}/${project.build.finalName}-react.zip"
                                                classifier="react" type="zip"/>
                        </target>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
